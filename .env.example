# Cloud IDE

# Public app URL (safe to expose)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Sandbox authentication
# On Vercel, prefer the project OIDC token.
VERCEL_OIDC_TOKEN=

# Alternative authentication (use instead of VERCEL_OIDC_TOKEN)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Keep the cloud runtime disabled until authentication + workspace ownership are implemented.
CLOUD_IDE_RUNTIME_ENABLED=false
